{
	"name": "@hush/web",
	"version": "0.0.0",
	"private": true,
	"description": "The Hush web app: React UI and browser adapters.",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "wrangler dev --config ../../deploy/cloudflare/wrangler.jsonc --port 8788",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
		"e2e": "vite build --mode e2e --outDir dist-e2e && playwright test",
		"measure": "node scripts/measure.ts",
		"e2e:real": "HUSH_MODELS=release vite build --mode e2e --outDir dist-real && playwright test -c playwright.real.config.ts"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@hush/core": "workspace:*",
		"@hush/ops": "workspace:*",
		"@jsquash/avif": "^2.1.1",
		"@jsquash/jpeg": "^1.6.0",
		"@jsquash/png": "^3.1.1",
		"@jsquash/webp": "^1.5.0",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-slider": "^1.4.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-switch": "^1.3.7",
		"@radix-ui/react-tooltip": "^1.2.16",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"comlink": "^4.4.2",
		"exifr": "^7.1.3",
		"i18next": "^26.4.2",
		"i18next-browser-languagedetector": "^8.2.1",
		"libheif-js": "^1.23.2",
		"lucide-react": "^1.49.0",
		"onnxruntime-web": "^1.30.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-i18next": "^17.0.15",
		"tailwind-merge": "^3.7.0",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^6.1.1",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.1"
	}
}
