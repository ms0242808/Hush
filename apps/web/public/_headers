# Hush response headers (Cloudflare static assets; also read by the e2e server).
#
# The CSP is the privacy promise made enforceable: the page can only connect to
# the origin it came from, which serves static files and accepts nothing.
# COOP + COEP make the page cross-origin isolated, which the multithreaded
# WASM fallback needs (SharedArrayBuffer).
#
# Path rules never overlap on a header: Cloudflare merges duplicates.

/*
  Content-Security-Policy: default-src 'self'; connect-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Content-hashed or versioned: cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/ort/*
  Cache-Control: public, max-age=31536000, immutable
/codecs/*
  Cache-Control: public, max-age=31536000, immutable
/models/parts/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Entry points and the model manifest: always revalidate.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/bench
  Cache-Control: no-cache
/bench/
  Cache-Control: no-cache
/models/manifest.json
  Cache-Control: no-cache
